configuration {
	modi: "window,run,drun";
	display-drun: "  Apps: ";
    	display-run: "  Run: ";
    	display-window: "  window: ";
    	display-Network: "󰤨  Network: ";
	lines: 5;
	show-icons: true;
	icon-theme: "Papirus-darl";
	terminal: "kitty";
	drun-display-format: "{icon} {name}";
	location: 0;
	slidebar-mode: true;
}

@theme "~/.cache/wal/colors-rofi-dark"

* {
    font:   "JetBrainsMonoNerdFont 16";

    background-color:   @background;
    text-color:         @foreground;

    margin:     0px;
    padding:    0px;
    spacing:    0px;
    background: #121315;
    /* ackground: #222222 ; */
}

window {
    location:       north;
    y-offset:       calc(50% - 176px);
    width:          800px;
    border-color: @active-background;
    border: 2px;
    border-radius: 16px;
    background-color:   @background; 
}

mainbox {
    padding:    12px;
}

inputbar {
    background-color:   @background;
    border-color:       @active-background;

    border:         2px;
    border-radius:  16px;

    padding:    8px 16px;
    spacing:    8px;
    children:   [ prompt, entry ];
}

prompt {
    text-color: @normal-foreground;
}

entry {
    placeholder:        "Search";
    placeholder-color:  @normal-foreground;
}

message {
    margin:             12px 0 0;
    border-radius:      16px;
    border-color:       @border-color;
    background-color:   @background;
}

textbox {
    padding:    8px 24px;
}

listview {
    background-color:  @background;

    margin:     12px 0 0;
    lines:      8;
    columns:    1;

    fixed-height: false;
}

element {
    padding:        8px 16px;
    spacing:        8px;
    border-radius:  16px;
}

element normal active {
    text-color: @active-foreground;
}

element alternate active {
    text-color: @alternate-active-foreground;
}

element selected normal{
    background-color:   @selected-normal-background;
}

element selected active {
    background-color: @selected-active-background;
}

element-icon {
    size:           1em;
    vertical-align: 0.5;
}

element-text {
    text-color: inherit;
}
